{
  "name": "agent-office",
  "displayName": "Agent Office — Who's working?",
  "description": "A pixel-art office in VS Code or in a standalone desktop app that shows which of your Claude Code agents is working right now (read-only, 100% local).",
  "version": "1.3.0",
  "publisher": "local",
  "icon": "media/extension-icon.png",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FabienPENCHENAT/agent-office.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "AI"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "agentOffice",
          "title": "Agent Office",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentOffice": [
        {
          "type": "webview",
          "id": "agentOffice.office",
          "name": "Office"
        }
      ]
    },
    "commands": [
      {
        "command": "agentOffice.show",
        "title": "Show the agent office",
        "category": "Agent Office"
      },
      {
        "command": "agentOffice.refresh",
        "title": "Refresh agent status",
        "category": "Agent Office"
      },
      {
        "command": "agentOffice.settings",
        "title": "Office settings",
        "category": "Agent Office",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentOffice.settings",
          "when": "view == agentOffice.office",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Agent Office",
      "properties": {
        "agentOffice.pollIntervalSeconds": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 60,
          "description": "How often (in seconds) the runtime signals are read."
        },
        "agentOffice.subagentSilenceMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "An unfinished subagent whose transcript has not changed for this long is shown as \"unknown\" instead of working."
        },
        "agentOffice.pinnedAgents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Agent names to place first among the ten desks, in this order. The others follow in alphabetical order."
        },
        "agentOffice.claudeConfigDir": {
          "type": "string",
          "default": "",
          "description": "Claude Code configuration folder. Empty = $CLAUDE_CONFIG_DIR or ~/.claude."
        },
        "agentOffice.showDefaultClaude": {
          "type": "boolean",
          "default": true,
          "description": "Shows a \"Claude\" character for Claude Code sessions started without --agent (your conversations with Claude itself), with the model it uses."
        },
        "agentOffice.sessionScope": {
          "type": "string",
          "default": "project",
          "enum": [
            "project",
            "all"
          ],
          "enumDescriptions": [
            "Only Claude Code sessions started in the open folders (or their subfolders)",
            "Every Claude Code session on this machine"
          ],
          "description": "Which Claude Code sessions animate the office. Your own and the project's agents are always shown; with no folder open, every session is shown."
        },
        "agentOffice.seasonalDecor": {
          "type": "boolean",
          "default": true,
          "description": "Seasonal decorations in the office, following the date. For now: winter, from December 1 to January 6 (snow outside, garlands, a Christmas tree, presents and Santa hats)."
        },
        "agentOffice.christmasDecor": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "markdownDeprecationMessage": "Replaced by `#agentOffice.seasonalDecor#`. Only `off` is still taken into account, when `seasonalDecor` isn't set."
        },
        "agentOffice.agentRooms": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "pm",
              "challenger",
              "design",
              "engineering"
            ]
          },
          "markdownDescription": "Forces an agent's room: `pm` (product manager office), `challenger`, `design` (UX/UI office) or `engineering` (open space). By default, the room is guessed from the agent's name, then from its description. Example: `{\"my-agent\": \"design\"}`."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "tsc -p . --noEmit && tsc -p tsconfig.webview.json",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "npm run compile && npx --yes @vscode/vsce@3.2.1 package --no-dependencies",
    "app": "npm run compile && electron out/standalone/main.js",
    "app:dist": "npm run compile && electron-builder",
    "app:dist:mac": "npm run compile && electron-builder --mac",
    "app:dist:win": "npm run compile && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "1.90.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "author": {
    "name": "Agent Office"
  },
  "homepage": "https://github.com/FabienPENCHENAT/agent-office",
  "build": {
    "appId": "com.agentoffice.app",
    "productName": "Agent Office",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*.js",
      "!out/test/**",
      "!out/extension.js",
      "!out/**/*.map",
      "media/**",
      "!media/icon.svg",
      "package.json"
    ],
    "extraMetadata": {
      "main": "out/standalone/main.js"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
